# Copy to .env in this directory and fill in values.
# The server loads this file from the project root (not server/).

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=calendar

# Optional override (otherwise built from POSTGRES_* above)
# DATABASE_URL=postgres://user:pass@localhost:5432/calendar

# --- Server (internal LAN only — do NOT forward this port on WAN; nginx on 443 proxies here) ---
PORT=3847
NODE_ENV=production
BASE_URL=https://smircich.ddns.net

# --- Auth (generate: openssl rand -hex 32) ---
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
JWT_EXPIRES_IN=365d

# --- Google OAuth (see AGENTS.md / setup walkthrough) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smircich.ddns.net/api/v1/calendars/oauth/callback

# --- Sync ---
SYNC_INTERVAL_MS=60000

# --- Kiosk OTA (all four required; upload APK to /var/www/family-calendar/releases/, then restart PM2) ---
# KIOSK_LATEST_VERSION=1.0.1
# KIOSK_LATEST_BUILD=17
# KIOSK_APK_URL=https://smircich.ddns.net/releases/app-kiosk-release.apk
# KIOSK_RELEASE_NOTES=Calendar improvements

# Optional: path to event sort rules (default: server/event-display-rules.json)
# EVENT_DISPLAY_RULES_PATH=

# --- Firebase App Distribution (copy to build machines .env) ---
# Android package: com.smircich.familycalendar (mobile — NOT .kiosk)
ANDROID_APP_ID=
# iOS bundle: com.smircich.familycalendar (same as Android mobile)
IOS_APP_ID=
FIREBASE_TESTERS_GROUP=family
# Optional kiosk OTA upload target (distribute-kiosk.bat / .sh)
# KIOSK_DEPLOY_HOST=bering-dev
# KIOSK_DEPLOY_PATH=/var/www/family-calendar/releases/app-kiosk-release.apk
